# Required for answers. Create a key at https://platform.openai.com/api-keys
# The AI SDK reads this variable. Do not commit the real value, and do not
# expose it to the browser.
OPENAI_API_KEY=

# Optional. An OpenAI model ID. Default: gpt-6-luna
# https://developers.openai.com/api/docs/models
OPENAI_MODEL=gpt-6-luna

# Optional. Free questions per browser per UTC day. Default: 10
DAILY_QUESTION_LIMIT=10

# Optional. Messages per UTC day for a day pass or subscription. Default: 300
UNLIMITED_DAILY_CAP=300

# Optional. Maximum tokens generated for one reply. Default: 420
MAX_OUTPUT_TOKENS=420

# Optional. Shown as "Support this teaching" on the website only.
# The iOS and Android apps do not open this link. They use the store's billing.
# The website has no checkout and does not use Stripe.
NEXT_PUBLIC_SUPPORT_URL=

# Optional. Absolute site URL for link previews. When unset, Vercel uses
# VERCEL_PROJECT_PRODUCTION_URL, then https://ask-buddha-wine.vercel.app.
NEXT_PUBLIC_SITE_URL=

# iOS purchases. These are server-only. StoreKit 2 receipts are verified
# locally against Apple Root CA G3. The In-App Purchase API key is optional
# and, when set, also confirms the transaction with the App Store Server API.
# Leave the API key unset and the free daily limit still works.
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY=
# Optional. Defaults to com.starseedsquad.askbuddha.
APPLE_BUNDLE_ID=
# Required before production purchases can be confirmed. Numeric Apple ID from
# App Store Connect. Ask AI Buddha does not exist there yet, so leave this unset.
# Sandbox and TestFlight receipts can be checked without it.
APPLE_APP_APPLE_ID=
# Optional. "true" also checks certificate revocation.
APPLE_IAP_ONLINE_CHECKS=
# Required to remember a verified unlock. Use a long random string.
# Do not commit a real value. Set it only on the server.
UNLOCK_COOKIE_SECRET=

# Optional. Owner-only code for the hidden tester sheet on this device.
# Tap the ASK BUDDHA title 7 times, then enter this code once.
# Do not commit a real value.
TESTER_RESET_CODE=

# Android purchases. Server-only. Leave this unset and the free daily limit still works.
# Paste the service account JSON, or that same JSON encoded as base64.
# The service account email must be invited in Play Console.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Optional. Defaults to com.starseedsquad.askbuddha.
GOOGLE_PLAY_PACKAGE_NAME=
